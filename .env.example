# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Database Configuration
DB_PATH=./data/cctv.db
FAISS_INDEX_PATH=./data/faces.index
FAISS_MAPPING_PATH=./data/faces_mapping.json
PHOTO_DIR=./data/photos/

# Detection and Recognition Thresholds
# If faces appear on live feed but no events/photos: lower DETECTION_THRESHOLD (e.g. 0.5)
DETECTION_THRESHOLD=0.7
RECOGNITION_THRESHOLD=0.45

# Pipeline Configuration
COOLDOWN_SECONDS=30

# Camera Configuration
# Options: "0" for webcam, path to video file, or "reachy" for Reachy Mini SDK
CAMERA_SOURCE=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Next.js Web App
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reachy Mini Wireless (when CAMERA_SOURCE=reachy)
# REACHY_MEDIA_BACKEND=gstreamer   # when running on robot (SSH)
# REACHY_MEDIA_BACKEND=webrtc      # when running from your computer (remote)
REACHY_MEDIA_BACKEND=webrtc